[alias]
  a = add
  chk = checkout
  br = branch
  cmit = commit
  cmit-no-edit = commit --amend --no-edit
  st = status
  lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all

[branch]
  sort = -committerdate

[colum]
  ui = auto

[core]
  editor = nvim

[color]
  ui = auto

[commit]
  gpgSign = true

[diff]
  renames = true

[gpg]
  format = ssh

[gpg "ssh"]
  program = ssh-keygen
  allowedSignersFile = ~/.ssh/allowed_signers

[init]
  defaultBranch = main

[status]
  branch = true

[tag]
  gpgSign = true

[user]
