{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "${HOME}/Pictures/misc/fastfetchart/*",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 6
    },
    "position": "left",
    "color": {
      "1": "#886A44"
    }
  },

  "display": {
    "separator": "",
    "key": {
      "type": "none"
    }
  },

  "modules": [
    "break",
    {
      "type": "custom",
      "format": "⠄⠄⠂⠁⠁⠂⠄⠄⠂⠁⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂ "
    },
    {
      "type": "custom",
      "format": "    ⠄⠄⠂⠁⠁⠂⠄⠄⠂⠁⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂⠁⠂⠄⠄⠂ "
    },
    {
      "type": "os",
      "format": "                        {pretty-name} \u001b[31m{arch}\u001b[0m"
    },
    {
      "type": "kernel",
      "format": "                  \u001b[31mkernel\u001b[0m {sysname} {release}"
    },
    {
      "type": "packages",
      "format": "                   \u001b[31mpackages\u001b[0m {xbps} (xbps)"
    },
    {
      "type": "command",
      "format": "                    \u001b[31mos age\u001b[0m {result}  ✧  °",
      "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days\""
    },
    {
      "type": "host",
      "format": "             \u001b[33mhost\u001b[0m {vendor} {name}"
    },
    {
      "type": "cpu",
      "format": "    ⁕     \u001b[33mcpu\u001b[0m {name}"
    },
    {
      "type": "gpu",
      "format": "      \u001b[33mgpu\u001b[0m {name}   ⠄⠄⠂⠁⠁⠂⠄⠄"
    },
    {
      "type": "memory",
      "format": "  \u001b[33mram\u001b[0m {used} / {total} (\u001b[35m{percentage}\u001b[0m)   ⠄"
    },
    {
      "type": "disk",
      "format": "  \u001b[33mdisk\u001b[0m {size-used} / {size-total} (\u001b[97m{size-percentage}\u001b[0m) - \u001b[31m{filesystem}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "𑽇"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33mif\u001b[0m you are curious about my knowledge ..."
    },
    "break",
    {
      "type": "users",
      "format": "\u001b[31m{name}\u001b[0m is at (\u001b[32m{session-name}\u001b[0m) {login-time}"
    },
    {
      "type": "shell",
      "format": "\u001b[33mShell\u001b[0m {pretty-name} {version}"
    },
    {
      "type": "uptime",
      "format": "\u001b[33mUptime\u001b[0m {hours} hours, {minutes} mins"
    },
        {
      "type": "wm",
      "format": "\u001b[33mWM\u001b[0m {pretty-name} [\u001b[32m{protocol-name}\u001b[0m]"
    },
    {
      "type": "terminal",
      "format": "\u001b[33mTerm\u001b[0m {pretty-name} {version}"
    },
    {
      "type": "terminalfont",
      "format": "\u001b[33mFont\u001b[0m {combined}"
    },
    {
      "type": "cursor",
      "format": "\u001b[33mCursor\u001b[0m {$XCURSOR_THEME} ({size}px)"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[31m火\u001b[0m \u001b[34m水\u001b[0m \u001b[32m木\u001b[0m \u001b[33m金\u001b[0m \u001b[35m土\u001b[0m 日 \u001b[37m月\u001b[0m"
    }
  ]
}
